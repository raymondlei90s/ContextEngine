# ContextEngine Configuration

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL="postgresql://contextengine:password@localhost:5432/contextengine?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Anthropic API
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5@20250929

# GitHub
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# GitLab
GITLAB_ACCESS_TOKEN=
GITLAB_WEBHOOK_SECRET=

# JIRA
JIRA_HOST=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Confluence
CONFLUENCE_HOST=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Vector Database (Pinecone - optional)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=

# Neo4j (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Object Storage (GCS/S3)
STORAGE_PROVIDER=local  # local | gcs | s3
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_KEY_FILE=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Feature Flags
ENABLE_LEARNING_LOOP=false
ENABLE_AUTONOMOUS_MODE=false
ENABLE_MULTI_FRAMEWORK=true
ENABLE_KNOWLEDGE_GRAPH=true
